{
  "name": "flex-ui",
  "private": true,
  "version": "1.0.0",
  "description": "FlexUI Studio - Interactive Visual UI Development & Scaffolding Studio",
  "author": "FlexUI Team <team@flexui.dev>",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "node server/server.js",
    "start": "node server/server.js",
    "py-service": "python3 python_service/app.py",
    "electron:dev": "node electron/dev.cjs",
    "electron:build": "npm run build && node electron/pack.cjs",
    "electron:mac": "npm run build && node electron/pack.cjs --mac --arm64",
    "electron:mac:arm64": "npm run build && node electron/pack.cjs --mac --arm64",
    "electron:mac:x64": "npm run build && node electron/pack.cjs --mac --x64",
    "electron:mac:universal": "npm run build && node electron/pack.cjs --mac --universal",
    "electron:mac:all": "npm run build && node electron/pack.cjs --mac --arm64 --x64",
    "electron:win": "npm run build && node electron/pack.cjs --win",
    "electron:linux": "npm run build && node electron/pack.cjs --linux",
    "docker:build": "docker build -t flexui .",
    "docker:run": "docker run -d -p 3000:80 --name flexui-container flexui",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down"
  },
  "build": {
    "appId": "com.flexui.studio",
    "productName": "FlexUI Studio",
    "electronVersion": "33.2.1",
    "copyright": "Copyright © 2026 FlexUI Team",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
